+#pragma once
+
+#include "Holodeck.h"
+
+#include "Command.h"
+
+#include "SpawnSceneObjectCommand.generated.h"
+
+/**
+ * SpawnSceneObjectCommand
+ *
+ * Spawns a StaticMeshActor into the running world from a mesh asset path, and
+ * applies actor tags to it. Used by the SSS scene-composition pipeline to build
+ * a randomized scene at runtime, without re-cooking the world package.
+ *
+ * This works for the raycast sonar family because those sensors line-trace the
+ * world every tick (they do not build a cached octree), so actors spawned after
+ * world start are still detected. Do NOT assume the same for octree-based sonars.
+ *
+ * NumberParameters (10 entries, client coordinate frame, meters / degrees):
+ *   [0..2]  location  x, y, z
+ *   [3..5]  rotation  roll, pitch, yaw
+ *   [6..8]  scale     x, y, z
+ *   [9]     burial ratio: fraction of the mesh's height to sink below the given z.
+ *           0 = sit on the seabed, 0.3 = 30% buried. Real wrecks are partly buried,
+ *           which also produces the correct shadow geometry. Computed here rather
+ *           than client-side because only the engine knows the mesh bounds.
+ *
+ * StringParameters (1 or more):
+ *   [0]     mesh asset path, e.g. "/Game/SssObjects/mado_1_ship_remaining_hull"
+ *   [1..]   actor tags to apply, e.g. "wreck", "sssmat:M_Wood_Pine"
+ *
+ * Spawned actors additionally receive the tag defined by SCENE_OBJECT_TAG so
+ * ClearSceneObjectsCommand can find and destroy them.
+ */
+UCLASS()
+class HOLODECK_API USpawnSceneObjectCommand : public UCommand {
+	GENERATED_BODY()
+
+public:
+	// See UCommand for the documentation of this overridden function.
+	void Execute() override;
+
+	/** Tag applied to every actor spawned by this command. */
+	static const TCHAR* SceneObjectTag() { return TEXT("sss_scene_object"); }
+};
