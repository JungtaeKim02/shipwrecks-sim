+namespace {
+	uint32 MixBits(uint32 X) {
+		X ^= X >> 16;
+		X *= 0x7feb352du;
+		X ^= X >> 15;
+		X *= 0x846ca68bu;
+		X ^= X >> 16;
+		return X;
+	}
+
+	uint32 LatticeHash(int32 X, int32 Y, int32 Z, uint32 Seed, uint32 Stream) {
+		uint32 H = MixBits(Seed ^ Stream);
+		H = MixBits(H ^ static_cast<uint32>(X) * 0x9e3779b9u);
+		H = MixBits(H ^ static_cast<uint32>(Y) * 0x85ebca6bu);
+		return MixBits(H ^ static_cast<uint32>(Z) * 0xc2b2ae35u);
+	}
+
+	float HashUniformOpen(uint32 H) {
+		// Map 24 useful hash bits to the open interval (0,1), avoiding log(0).
+		return (static_cast<float>((MixBits(H) >> 8) + 1u)) / 16777217.0f;
+	}
+
+	void HashNormalPair(uint32 H, float& OutA, float& OutB) {
+		const float U1 = HashUniformOpen(H);
+		const float U2 = HashUniformOpen(H ^ 0xa511e9b3u);
+		const float R = FMath::Sqrt(-2.0f * FMath::Loge(U1));
+		const float P = 2.0f * PI * U2;
+		OutA = R * FMath::Cos(P);
+		OutB = R * FMath::Sin(P);
+	}
+
+	float SmoothWeight(float T) {
+		T = FMath::Clamp(T, 0.0f, 1.0f);
+		return T * T * (3.0f - 2.0f * T);
+	}
+
+	float GammaUnitSample(float Shape, uint32 Seed) {
+		if (!(Shape > 0.0f)) {
+			return 1.0f;
+		}
+		FRandomStream Rng(static_cast<int32>(Seed));
+		auto NormalDraw = [&Rng]() {
+			const float U1 = FMath::Clamp(Rng.FRand(), 1e-7f, 1.0f);
+			const float U2 = Rng.FRand();
+			return FMath::Sqrt(-2.0f * FMath::Loge(U1))
+				 * FMath::Cos(2.0f * PI * U2);
+		};
+
+		float Boost = 1.0f;
+		float K = Shape;
+		if (K < 1.0f) {
+			const float U = FMath::Clamp(Rng.FRand(), 1e-7f, 1.0f);
+			Boost = FMath::Pow(U, 1.0f / K);
+			K += 1.0f;
+		}
+		const float D = K - 1.0f / 3.0f;
+		const float C = 1.0f / FMath::Sqrt(9.0f * D);
+		for (int Attempt = 0; Attempt < 64; ++Attempt) {
+			const float X = NormalDraw();
+			const float OnePlus = 1.0f + C * X;
+			if (OnePlus <= 0.0f) {
+				continue;
+			}
+			const float V = OnePlus * OnePlus * OnePlus;
+			const float U = FMath::Clamp(Rng.FRand(), 1e-7f, 1.0f);
+			if (U < 1.0f - 0.0331f * X * X * X * X
+				|| FMath::Loge(U) < 0.5f * X * X + D * (1.0f - V + FMath::Loge(V))) {
+				// Gamma(K,1), adjusted for K<1, then divided by original shape:
+				// unit mean and variance 1/Shape.
+				return FMath::Max(0.0f, D * V * Boost / Shape);
+			}
+		}
+		return 1.0f;
+	}
