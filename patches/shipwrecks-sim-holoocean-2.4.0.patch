+void URaycastSidescanSonar::WorldComplexGaussian(
+	const FVector& WorldPoint,
+	float& OutReal,
+	float& OutImag) const {
+	const float Cell = FMath::Max(ScatterCorrelationLengthCm, 1e-3f);
+	const FVector P = WorldPoint / Cell;
+	const int32 X0 = FMath::FloorToInt(P.X);
+	const int32 Y0 = FMath::FloorToInt(P.Y);
+	const int32 Z0 = FMath::FloorToInt(P.Z);
+	const float Fx = SmoothWeight(P.X - static_cast<float>(X0));
+	const float Fy = SmoothWeight(P.Y - static_cast<float>(Y0));
+	const float Fz = SmoothWeight(P.Z - static_cast<float>(Z0));
+
+	float Real = 0.0f;
+	float Imag = 0.0f;
+	float VarianceWeight = 0.0f;
+	for (int Dz = 0; Dz <= 1; ++Dz) {
+		const float Wz = Dz ? Fz : 1.0f - Fz;
+		for (int Dy = 0; Dy <= 1; ++Dy) {
+			const float Wy = Dy ? Fy : 1.0f - Fy;
+			for (int Dx = 0; Dx <= 1; ++Dx) {
+				const float Wx = Dx ? Fx : 1.0f - Fx;
+				const float W = Wx * Wy * Wz;
+				float NReal;
+				float NImag;
+				HashNormalPair(
+					LatticeHash(
+						X0 + Dx,
+						Y0 + Dy,
+						Z0 + Dz,
+						ResolvedScatterSeed,
+						0x53435352u),
+					NReal,
+					NImag);
+				Real += W * NReal;
+				Imag += W * NImag;
+				VarianceWeight += W * W;
+			}
+		}
+	}
+	// HashNormalPair components are N(0,1). Divide by sqrt(2) for CN(0,1), and
+	// compensate interpolation variance so E(|G|^2)=1 everywhere in a lattice cell.
+	const float Scale = 1.0f / FMath::Sqrt(FMath::Max(2.0f * VarianceWeight, 1e-12f));
+	OutReal = Real * Scale;
+	OutImag = Imag * Scale;
+}
+
+float URaycastSidescanSonar::WorldGammaTexture(const FVector& WorldPoint) const {
+	if (!(TextureShape > 0.0f)) {
+		return 1.0f;
+	}
+	const float Cell = FMath::Max(TextureCorrelationLengthCm, 1e-3f);
+	const FVector P = WorldPoint / Cell;
+	const int32 X0 = FMath::FloorToInt(P.X);
+	const int32 Y0 = FMath::FloorToInt(P.Y);
+	const int32 Z0 = FMath::FloorToInt(P.Z);
+	const float Fx = SmoothWeight(P.X - static_cast<float>(X0));
+	const float Fy = SmoothWeight(P.Y - static_cast<float>(Y0));
+	const float Fz = SmoothWeight(P.Z - static_cast<float>(Z0));
+
+	float Texture = 0.0f;
+	for (int Dz = 0; Dz <= 1; ++Dz) {
+		const float Wz = Dz ? Fz : 1.0f - Fz;
+		for (int Dy = 0; Dy <= 1; ++Dy) {
+			const float Wy = Dy ? Fy : 1.0f - Fy;
+			for (int Dx = 0; Dx <= 1; ++Dx) {
+				const float Wx = Dx ? Fx : 1.0f - Fx;
+				const uint32 H = LatticeHash(
+					X0 + Dx,
+					Y0 + Dy,
+					Z0 + Dz,
+					ResolvedScatterSeed,
+					0x54455854u);
+				Texture += Wx * Wy * Wz * GammaUnitSample(TextureShape, H);
+			}
+		}
+	}
+	return FMath::Max(Texture, 0.0f);
+}
+
+void URaycastSidescanSonar::AccumulateCoherentScatter(
+	int ElevationIndex,
+	bool bLeft,
+	float RangeCm,
+	float MeanPower,
+	const FVector& ScatterPoint) {
+	const float P = FMath::Max(MeanPower * WorldGammaTexture(ScatterPoint), 0.0f);
+	if (bLeft) {
+		leftHists[ElevationIndex](bh::weight(P), RangeCm);
+	} else {
+		Hists[ElevationIndex](bh::weight(P), RangeCm);
+	}
+	if (!(P > 0.0f)) {
+		return;
+	}
+
+	// Store power-weighted coordinate moments.  Sampling one unit-variance complex
+	// field at the fused cell centroid is the statistically resolved-cell model;
+	// summing one correlated draw per numerical ray would make speckle mean depend on
+	// ray density and produced severe brightness bias in the packaged A/B image.
+	const float XMoment = P * ScatterPoint.X;
+	const float YMoment = P * ScatterPoint.Y;
+	const float ZMoment = P * ScatterPoint.Z;
+	if (bLeft) {
+		leftCoherentRealHists[ElevationIndex](bh::weight(XMoment), RangeCm);
+		leftCoherentImagHists[ElevationIndex](bh::weight(YMoment), RangeCm);
+		leftCoherentZHists[ElevationIndex](bh::weight(ZMoment), RangeCm);
+	} else {
+		coherentRealHists[ElevationIndex](bh::weight(XMoment), RangeCm);
+		coherentImagHists[ElevationIndex](bh::weight(YMoment), RangeCm);
+		coherentZHists[ElevationIndex](bh::weight(ZMoment), RangeCm);
+	}
+}
+
+void URaycastSidescanSonar::StandardNormalPair(float& OutReal, float& OutImag) {
+	// Box-Muller: two uniforms -> two independent N(0,1) samples.
+	const float U1 = FMath::Clamp(SpeckleStream.FRand(), 1e-7f, 1.0f);
+	const float U2 = SpeckleStream.FRand();
+	const float Radius = FMath::Sqrt(-2.0f * FMath::Loge(U1));
+	const float Phase = 2.0f * PI * U2;
+	OutReal = Radius * FMath::Cos(Phase);
+	OutImag = Radius * FMath::Sin(Phase);
+}
+
+float URaycastSidescanSonar::ComplexSpecklePowerFactor() {
+	if (SpeckleDist == ESpeckleDistribution::Off) {
+		return 1.0f;
+	}
+	const float DiffuseFraction = FMath::Clamp(SpeckleStrength, 0.0f, 1.0f);
+	float NReal;
+	float NImag;
+	StandardNormalPair(NReal, NImag);
+	// G = (NReal + i*NImag)/sqrt(2) -> E|G|^2=1.
+	const float DiffuseScale = FMath::Sqrt(DiffuseFraction * 0.5f);
+	const float Coherent = FMath::Sqrt(1.0f - DiffuseFraction);
+	const float ZReal = Coherent + DiffuseScale * NReal;
+	const float ZImag = DiffuseScale * NImag;
+	return ZReal * ZReal + ZImag * ZImag;
+}
+
+const TCHAR* URaycastSidescanSonar::SpeckleDistName() const {
+	switch (SpeckleDist) {
+		case ESpeckleDistribution::Off: return TEXT("off");
+		default:                        return TEXT("complex_gaussian_power");
+	}
+}
+
+const TCHAR* URaycastSidescanSonar::SignalModelName() const {
+	return SignalModel == ESSSSignalModel::CoherentField
+		? TEXT("coherent_field_iq")
+		: TEXT("detected_power");
+}
+
+float URaycastSidescanSonar::BeamPatternAxisPower1Way(
+	float AngleDeg,
+	float FullBeamwidthDeg) const {
+	// One-way amplitude directivity of a uniformly excited line array (broadside),
+	//   D(theta) = sinc(pi * (L/lambda) * sin theta),   sinc(x) = sin(x)/x.
+	// Half-power (|D|^2 = 1/2) occurs at pi*(L/lambda)*sin(theta) = 1.39156, so fixing
+	// the one-way -3 dB full beamwidth gives pi*L/lambda = 1.39156/sin(BW/2).
+	const float halfBW = FMath::DegreesToRadians(FullBeamwidthDeg * 0.5f);
+	if (!(halfBW > 0.f)) {
+		return 1.f;
+	}
+	const float k = 1.39156f / FMath::Sin(halfBW);
+	const float x = k * FMath::Sin(FMath::DegreesToRadians(AngleDeg));
+	const float D = (FMath::Abs(x) < 1e-6f) ? 1.f : (FMath::Sin(x) / x);  // one-way amp
+	return D * D;
+}
+
+float URaycastSidescanSonar::BeamPatternPower1Way(
+	float ElevAngleDeg,
+	float HorizontalAngleDeg) const {
+	return BeamPatternAxisPower1Way(ElevAngleDeg, VerticalBeamwidthDeg)
+		 * BeamPatternAxisPower1Way(HorizontalAngleDeg, Azimuth);
+}
+
+float URaycastSidescanSonar::BeamPattern2Way(
+	float ElevAngleDeg,
+	float HorizontalAngleDeg) const {
+	const float OneWay = BeamPatternPower1Way(ElevAngleDeg, HorizontalAngleDeg);
+	return OneWay * OneWay;
+}
