diff --git a/engine/Source/Holodeck/Sensors/Tests/RaycastSidescanSonar.spec.cpp b/engine/Source/Holodeck/Sensors/Tests/RaycastSidescanSonar.spec.cpp
new file mode 100644
index 00000000..64cb6c1b
--- /dev/null
+++ b/engine/Source/Holodeck/Sensors/Tests/RaycastSidescanSonar.spec.cpp
@@ -0,0 +1,73 @@
+#include "Misc/AutomationTest.h"
+#include "RaycastSidescanSonar.h"
+
+BEGIN_DEFINE_SPEC(
+	URaycastSidescanSonarSpec,
+	"HoloOcean.URaycastSidescanSonar.CoherentField",
+	EAutomationTestFlags::ProductFilter | EAutomationTestFlags::ApplicationContextMask)
+URaycastSidescanSonar* Sonar = nullptr;
+END_DEFINE_SPEC(URaycastSidescanSonarSpec)
+
+void URaycastSidescanSonarSpec::Define() {
+	BeforeEach([this]() {
+		Sonar = NewObject<URaycastSidescanSonar>();
+		Sonar->ResolvedScatterSeed = 20260809u;
+		Sonar->ScatterCorrelationLengthCm = 5.0f;
+	});
+
+	It("is deterministic at a fixed world coordinate", [this]() {
+		float AReal, AImag, BReal, BImag;
+		const FVector P(123.4f, -89.0f, 17.0f);
+		Sonar->WorldComplexGaussian(P, AReal, AImag);
+		Sonar->WorldComplexGaussian(P, BReal, BImag);
+		TestEqual("real component", AReal, BReal);
+		TestEqual("imaginary component", AImag, BImag);
+	});
+
+	It("has approximately unit complex variance", [this]() {
+		double Power = 0.0;
+		constexpr int N = 10000;
+		for (int I = 0; I < N; ++I) {
+			float Real, Imag;
+			// Lattice vertices are independent; non-integer offsets also exercise
+			// interpolation-variance normalization.
+			const FVector P(
+				5.0f * I + 1.7f,
+				5.0f * ((I * 37) % 10007) + 2.1f,
+				5.0f * ((I * 101) % 997) + 0.9f);
+			Sonar->WorldComplexGaussian(P, Real, Imag);
+			Power += Real * Real + Imag * Imag;
+		}
+		const double MeanPower = Power / N;
+		TestTrue("E|G|^2 close to one", FMath::Abs(MeanPower - 1.0) < 0.04);
+	});
+
+	It("produces a unit-mean Gamma texture", [this]() {
+		Sonar->ResolvedScatterSeed = 20260809u;
+		Sonar->TextureShape = 2.0f;
+		Sonar->TextureCorrelationLengthCm = 100.0f;
+		double Sum = 0.0;
+		constexpr int N = 10000;
+		for (int I = 0; I < N; ++I) {
+			// Sample lattice vertices so the configured Gamma marginal is tested
+			// without the intended smoothing effect of interpolation.
+			Sum += Sonar->WorldGammaTexture(
+				FVector(100.0f * I, 100.0f * ((I * 53) % 10009), 0.0f));
+		}
+		const double Mean = Sum / N;
+		TestTrue("Gamma texture mean close to one", FMath::Abs(Mean - 1.0) < 0.04);
+	});
+
+	It("places the one-way half-power point at half beamwidth", [this]() {
+		const float P = Sonar->BeamPatternAxisPower1Way(0.5f, 1.0f);
+		TestTrue("one-way edge power close to 0.5", FMath::Abs(P - 0.5f) < 0.01f);
+	});
+
+	It("keeps nominal beamwidth independent of ray support", [this]() {
+		Sonar->Elevation = 68.0f;
+		Sonar->VerticalBeamwidthDeg = 50.0f;
+		Sonar->Azimuth = 1.0f;
+		const float P = Sonar->BeamPatternPower1Way(25.0f, 0.0f);
+		TestTrue("25deg is the nominal one-way -3dB point", FMath::Abs(P - 0.5f) < 0.01f);
+	});
+}
