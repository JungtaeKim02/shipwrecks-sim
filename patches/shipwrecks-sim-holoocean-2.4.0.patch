diff --git a/engine/Source/Holodeck/ClientCommands/Private/ClearSceneObjectsCommand.cpp b/engine/Source/Holodeck/ClientCommands/Private/ClearSceneObjectsCommand.cpp
new file mode 100644
index 00000000..780665df
--- /dev/null
+++ b/engine/Source/Holodeck/ClientCommands/Private/ClearSceneObjectsCommand.cpp
@@ -0,0 +1,35 @@
+#include "ClearSceneObjectsCommand.h"
+#include "Holodeck.h"
+
+#include "SpawnSceneObjectCommand.h"
+#include "EngineUtils.h"
+#include "Engine/StaticMeshActor.h"
+
+void UClearSceneObjectsCommand::Execute() {
+	UE_LOG(LogHolodeck, Log, TEXT("ClearSceneObjectsCommand::Execute"));
+
+	UWorld* World = Target->GetWorld();
+	if (World == nullptr) {
+		UE_LOG(LogHolodeck, Error, TEXT("ClearSceneObjectsCommand: no world."));
+		return;
+	}
+
+	const FName			 Tag = FName(USpawnSceneObjectCommand::SceneObjectTag());
+	TArray<AActor*>		 ToDestroy;
+
+	for (TActorIterator<AStaticMeshActor> It(World); It; ++It) {
+		if (It->ActorHasTag(Tag)) {
+			ToDestroy.Add(*It);
+		}
+	}
+
+	for (AActor* Actor : ToDestroy) {
+		Actor->Destroy();
+	}
+
+	UE_LOG(
+		LogHolodeck,
+		Log,
+		TEXT("ClearSceneObjectsCommand: destroyed %d scene object(s)."),
+		ToDestroy.Num());
+}
