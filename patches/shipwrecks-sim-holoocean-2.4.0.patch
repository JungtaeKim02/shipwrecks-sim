+	 * Speckle RNG. Each complex Gaussian draw consumes two uniforms (Box-Muller).
+	 * Seeded from the
+	 * `SpeckleSeed` config.
+	 *
+	 * Thread safety: ComplexSpecklePowerFactor() is only called from
+	 * CopyHistogramsToBuffer(),
+	 * which runs single-threaded after the ParallelFor over elevation angles.
+	 */
+	FRandomStream SpeckleStream;
+	int32 SpeckleSeed = 0;
+	// Diffuse power fraction in [0, 1]. 1 = fully developed power speckle, 0 = coherent.
+	float SpeckleStrength = 1.0f;
+
+	ESpeckleDistribution SpeckleDist = ESpeckleDistribution::ComplexGaussian;
+	// Engine-level fallback stays intensity for binary compatibility with an old
+	// client that does not send SignalModel. The updated Python client explicitly
+	// requests coherent mode by default and allocates the matching I/Q buffer.
+	ESSSSignalModel SignalModel = ESSSSignalModel::Intensity;
 
-	// Noise
-	MultivariateNormal<1> addNoise;
-	MultivariateNormal<1> multNoise;
+	// Carrier and unresolved-scattering field parameters. UE geometry uses cm;
+	// configuration values are supplied in SI and converted during parsing.
+	float CarrierFrequencyHz = 520000.0f;
+	float ScatterCorrelationLengthCm = 5.0f;
+	float TextureCorrelationLengthCm = 100.0f;
+	float TextureShape = 0.0f;
+	uint32 ResolvedScatterSeed = 1u;
 };
