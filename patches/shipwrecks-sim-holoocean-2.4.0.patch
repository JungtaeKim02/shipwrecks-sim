diff --git a/engine/Source/Holodeck/ClientCommands/Private/SpawnSceneObjectCommand.cpp b/engine/Source/Holodeck/ClientCommands/Private/SpawnSceneObjectCommand.cpp
new file mode 100644
index 00000000..bf9476cb
--- /dev/null
+++ b/engine/Source/Holodeck/ClientCommands/Private/SpawnSceneObjectCommand.cpp
@@ -0,0 +1,136 @@
+#include "SpawnSceneObjectCommand.h"
+#include "Holodeck.h"
+
+#include "Engine/StaticMesh.h"
+#include "Engine/StaticMeshActor.h"
+#include "Components/StaticMeshComponent.h"
+
+void USpawnSceneObjectCommand::Execute() {
+	UE_LOG(LogHolodeck, Log, TEXT("SpawnSceneObjectCommand::Execute"));
+
+	if (NumberParams.size() < 10 || StringParams.size() < 1) {
+		UE_LOG(
+			LogHolodeck,
+			Error,
+			TEXT("SpawnSceneObjectCommand expects 10 number parameters and at "
+				 "least 1 string parameter (mesh path). Command not executed."));
+		return;
+	}
+
+	UWorld* World = Target->GetWorld();
+	if (World == nullptr) {
+		UE_LOG(LogHolodeck, Error, TEXT("SpawnSceneObjectCommand: no world."));
+		return;
+	}
+
+	const FString MeshPath = FString(StringParams[0].c_str());
+	UStaticMesh*  Mesh = LoadObject<UStaticMesh>(nullptr, *MeshPath);
+	if (Mesh == nullptr) {
+		UE_LOG(
+			LogHolodeck,
+			Error,
+			TEXT("SpawnSceneObjectCommand: could not load static mesh '%s'. Is it "
+				 "cooked into the package? Command not executed."),
+			*MeshPath);
+		return;
+	}
+
+	// Client frame (meters, x forward / y left / z up) -> UE frame (cm, left handed).
+	FVector Location = FVector(NumberParams[0], NumberParams[1], NumberParams[2]);
+	Location = ConvertLinearVector(Location, ClientToUE);
+
+	// 회전은 **FRotator 오버로드**로 변환해야 한다.
+	//
+	// FVector 오버로드(Conversion.cpp:113)는 선형 단위 배율 UEUnitsPerMeter(=100) 을
+	// 성분에 곱한다. 각속도/위치용이라 그렇게 되어 있는데, 여기에 각도를 넣으면
+	// 100 배가 된다: yaw 45 -> -4500 deg (= 180), yaw 90 -> -9000 deg (= 0).
+	// 실제로 yaw 0/45/90 으로 스폰한 세 척이 전부 같은 방향으로 나왔다(2026-08-04).
+	// FRotator 오버로드(같은 파일 133 행)는 배율 없이 Roll/Yaw 부호만 뒤집는다.
+	FRotator Rotation(NumberParams[4], NumberParams[5], NumberParams[3]);  // Pitch, Yaw, Roll
+	Rotation = ConvertAngularVector(Rotation, ClientToUE);
+
+	FActorSpawnParameters SpawnParams;
+	SpawnParams.SpawnCollisionHandlingOverride =
+		ESpawnActorCollisionHandlingMethod::AlwaysSpawn;
+
+	AStaticMeshActor* Actor =
+		World->SpawnActor<AStaticMeshActor>(AStaticMeshActor::StaticClass(), Location, Rotation, SpawnParams);
+	if (Actor == nullptr) {
+		UE_LOG(LogHolodeck, Error, TEXT("SpawnSceneObjectCommand: spawn failed."));
+		return;
+	}
+
+	// Mobility must be Movable. An actor spawned after level load cannot be Static:
+	// UE will not (re)create its physics state, which leaves the mesh visible but with
+	// no collision — the sonar's line traces pass straight through it. Mobility does
+	// not affect trace channels, so Movable costs us nothing here.
+	UStaticMeshComponent* MeshComponent = Actor->GetStaticMeshComponent();
+	MeshComponent->SetMobility(EComponentMobility::Movable);
+	MeshComponent->SetStaticMesh(Mesh);
+	MeshComponent->SetWorldScale3D(
+		FVector(NumberParams[6], NumberParams[7], NumberParams[8]));
+
+	// Be explicit about collision rather than relying on the spawn default: the sonar
+	// traces ECC_GameTraceChannel3/4, whose default response is Block, but only for
+	// components that actually have query collision enabled.
+	MeshComponent->SetCollisionEnabled(ECollisionEnabled::QueryAndPhysics);
+	MeshComponent->SetCollisionProfileName(TEXT("BlockAll"));
+	MeshComponent->SetCollisionResponseToAllChannels(ECR_Block);
+
+	// Sink the mesh by a fraction of its own height. Only the engine knows the bounds,
+	// so the client passes a ratio and we resolve it to a world offset here.
+	const float BurialRatio = FMath::Clamp(NumberParams[9], 0.0f, 1.0f);
+	if (BurialRatio > 0.0f) {
+		// "제 높이의 몇 %" 는 **세워진 뒤의 수직 범위** 여야 한다.
+		// 예전에는 메시 로컬 Z 범위만 썼는데, 자산마다 로컬 Z 가 가리키는 치수가
+		// 달라(최대변 대비 0.21 ~ 1.00 로 실측됨) 같은 비율을 줘도 어떤 난파선은
+		// 거의 안 묻히고 어떤 것은 통째로 들어갔다(2026-08-04).
+		// 회전을 적용한 월드 AABB 의 Z 범위를 쓰면 자산·자세와 무관하게 일관된다.
+		const FVector Ext = Mesh->GetBounds().BoxExtent * FMath::Abs(NumberParams[8]);
+		const FMatrix Rot = FRotationMatrix(Rotation);
+		const float HeightCm = 2.0f * (FMath::Abs(Rot.M[0][2]) * Ext.X
+									 + FMath::Abs(Rot.M[1][2]) * Ext.Y
+									 + FMath::Abs(Rot.M[2][2]) * Ext.Z);
+		Actor->SetActorLocation(Location - FVector(0.0f, 0.0f, BurialRatio * HeightCm));
+	}
+
+	// The asset itself must be imported with CTF_USE_COMPLEX_AS_SIMPLE, because the
+	// sonar traces with bTraceComplex = false and needs a valid FaceIndex to resolve
+	// the material. We warn loudly here rather than fail silently with a white blob.
+	if (Mesh->GetBodySetup() != nullptr
+		&& Mesh->GetBodySetup()->CollisionTraceFlag != ECollisionTraceFlag::CTF_UseComplexAsSimple) {
+		UE_LOG(
+			LogHolodeck,
+			Warning,
+			TEXT("SpawnSceneObjectCommand: mesh '%s' is NOT set to "
+				 "CTF_USE_COMPLEX_AS_SIMPLE. Sonar will hit its simple (box) "
+				 "collision and material lookup will fail -> object renders "
+				 "uniformly bright. Re-import it with the SSS import commandlet."),
+			*MeshPath);
+	}
+
+	Actor->Tags.Add(FName(SceneObjectTag()));
+	for (size_t i = 1; i < StringParams.size(); ++i) {
+		const FString Tag = FString(StringParams[i].c_str());
+		if (!Tag.IsEmpty()) {
+			Actor->Tags.Add(FName(*Tag));
+		}
+	}
+
+	// Diagnostics: a scene object that is present but not detected by the sonar is the
+	// hard failure mode here (no error, just an empty waterfall), so log enough state
+	// to tell "not spawned" from "spawned but not collidable" from "spawned elsewhere".
+	const FVector  FinalLoc = Actor->GetActorLocation();
+	const FBoxSphereBounds WorldBounds = MeshComponent->Bounds;
+	UE_LOG(
+		LogHolodeck,
+		Log,
+		TEXT("SpawnSceneObjectCommand: spawned '%s' tags=%d loc_ue=(%.0f,%.0f,%.0f) "
+			 "extent_ue=(%.0f,%.0f,%.0f) collision=%d channel4=%d"),
+		*MeshPath,
+		Actor->Tags.Num(),
+		FinalLoc.X, FinalLoc.Y, FinalLoc.Z,
+		WorldBounds.BoxExtent.X, WorldBounds.BoxExtent.Y, WorldBounds.BoxExtent.Z,
+		static_cast<int32>(MeshComponent->GetCollisionEnabled()),
+		static_cast<int32>(MeshComponent->GetCollisionResponseToChannel(ECC_GameTraceChannel4)));
+}
