+		for (const TSharedPtr<FJsonValue>& Item : *StonesArr) {
+			const TSharedPtr<FJsonObject> ItemObj = Item->AsObject();
+			if (!ItemObj.IsValid()) {
+				continue;
+			}
+			FMadoAnchorStoneConfig Stone;
+			Stone.Id = GetStr(ItemObj, TEXT("id"), TEXT(""));
