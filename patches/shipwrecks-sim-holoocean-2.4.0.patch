+void URaycastSidescanSonar::TraceMultipath(
+	const FHitResult&	   FirstHit,
+	const SonarDetection&  FirstDetection,
+	const FTransform&	   ActorTransf,
+	const FVector&		   SonarBodyLoc,
+	const FRotator&		   SonarBodyRot,
+	FCollisionQueryParams& TraceParams,
+	MultipathEcho&		   Out) {
+	Out = MultipathEcho();
+
+	// Symbols follow Algorithm 1 of the HoloOcean sonar paper (sec. III-B):
+	//   p_B, n_B : first bounce point and its surface normal   -> P1, N1
+	//   r_B      : specular reflection of the incident ray at B -> RB
+	//   p, n_H   : second bounce point and its surface normal   -> P2, N2
+	//   q        : r_B specularly reflected again at H          -> Q
+	//   v_H      : unit vector from H back to the sonar         -> VH
+	//   i        : q . v_H, the fraction that heads home        -> Align
+	//   d        : (|p_B| + |p| + |p_B - p|) / 2                -> Reported
+	const FVector P1 = FirstHit.ImpactPoint;
+	const FVector N1 = FirstHit.ImpactNormal;
+	const FVector Din = (P1 - SonarBodyLoc).GetSafeNormal();
+	if (Din.IsNearlyZero()) {
+		return;
+	}
+	const FVector RB = Din - 2.0f * FVector::DotProduct(Din, N1) * N1;
+
+	// Budget for the second leg. The reported range is half the total path, so
+	//   (|SB| + |BH| + |HS|) / 2 <= RangeMax, and |HS| >= 0
+	// gives |BH| <= 2*RangeMax - |SB|. Anything longer can only land out of range.
+	const float D1 = FirstHit.Distance;
+	const float Budget = 2.0f * RangeMax - D1;
+	if (Budget <= 1.0f) {
+		return;
+	}
+
+	static thread_local FHitResult Hit2(ForceInit);
+	Hit2.Reset();
+	// Start 1 cm off the surface so we do not immediately re-hit the face we left.
+	const FVector Start2 = P1 + RB;
+	const FVector End2 = P1 + RB * Budget;
+	if (bIgnorePlants) {
+		GetWorld()->LineTraceSingleByChannel(
+			Hit2,
+			Start2,
+			End2,
+			ECC_GameTraceChannel4,
+			TraceParams,
+			FCollisionResponseParams::DefaultResponseParam);
+	} else {
+		GetWorld()->LineTraceSingleByChannel(
+			Hit2,
+			Start2,
+			End2,
+			ECC_GameTraceChannel3,
+			TraceParams,
+			FCollisionResponseParams::DefaultResponseParam);
+	}
+	if (!Hit2.bBlockingHit) {
+		return;
+	}
+
+	const FVector P2 = Hit2.ImpactPoint;
+	const FVector N2 = Hit2.ImpactNormal;
+
+	const FVector ToSonar = SonarBodyLoc - P2;
+	const float	  D3 = ToSonar.Size();
+	if (D3 < KINDA_SMALL_NUMBER) {
+		return;
+	}
+	const FVector VH = ToSonar / D3;
+
+	const FVector Q = RB - 2.0f * FVector::DotProduct(RB, N2) * N2;
+	const float	  Align = FVector::DotProduct(Q, VH);
+	if (Align <= 0.0f) {
+		// The second specular lobe points away from the sonar: nothing comes back.
+		return;
+	}
+
+	const float D2 = FVector::Dist(P1, P2);
+	const float Reported = 0.5f * (D1 + D2 + D3);
+	if (Reported < RangeMin || Reported > RangeMax) {
+		return;
+	}
+
+	// Reflection coefficient of each surface. The first one is already resolved on
+	// the direct detection, so only the second needs a material lookup.
+	const float Z1 = FirstDetection.impedance_override > 0.0f
+					   ? FirstDetection.impedance_override
+					   : GetImpedanceFromMap(FirstDetection.material_type);
+	const SonarDetection Second = ComputeDetection(Hit2, ActorTransf);
+	const float			 Z2 = Second.impedance_override > 0.0f
+					   ? Second.impedance_override
+					   : GetImpedanceFromMap(Second.material_type);
+	const float R1 = (Z1 - WaterImpedance) / (Z1 + WaterImpedance);
+	const float R2 = (Z2 - WaterImpedance) / (Z2 + WaterImpedance);
+
+	// Angle the echo comes back from, in the sonar body frame. It is NOT the
+	// transmit angle, which is why the caller cannot use the two-way pattern.
+	// Local is the sonar -> P2 direction; with the body rotation removed its
+	// components match the (Pitch = elevation, Yaw = azimuth) convention ShootRay
+	// builds its rays with, so Local.Y < 0 is the same "port" test as h < 0.
+	const FVector Local = SonarBodyRot.UnrotateVector(-VH);
+	const float	  Horiz = FMath::Sqrt(Local.X * Local.X + Local.Y * Local.Y);
+
+	Out.bValid = true;
+	Out.distance = Reported;
+	Out.val = R1 * R1 * R2 * R2 * Align;
+	Out.elev_rx_deg = FMath::RadiansToDegrees(FMath::Atan2(Local.Z, Horiz));
+	Out.azim_rx_deg = FMath::RadiansToDegrees(FMath::Atan2(Local.Y, Local.X));
+	Out.bLeft = (Local.Y < 0.0f);
+	Out.scatter_point = P2;
+}
