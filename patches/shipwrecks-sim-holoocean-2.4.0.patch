@@ -0,0 +1,26 @@
+#pragma once
+
+#include "Holodeck.h"
+
+#include "Command.h"
+
+#include "ClearSceneObjectsCommand.generated.h"
+
+/**
+ * ClearSceneObjectsCommand
+ *
+ * Destroys every actor previously spawned by SpawnSceneObjectCommand (i.e. every
+ * actor carrying USpawnSceneObjectCommand::SceneObjectTag()). Used to reset the
+ * scene between randomized compositions inside one running environment.
+ *
+ * NumberParameters are expected to be empty.
+ * StringParameters are expected to be empty.
+ */
+UCLASS()
+class HOLODECK_API UClearSceneObjectsCommand : public UCommand {
+	GENERATED_BODY()
+
+public:
+	// See UCommand for the documentation of this overridden function.
+	void Execute() override;
+};
